use el_oasere;
create table Article (
NumArt int primary key ,
libell nvarchar (50),
Stock int,
Prixuinti int ,
);
create  table Fournissuers (
NumFour int primary key ,
Nom nvarchar (50),
Adresse nvarchar (50),
Ville nvarchar (50),
) ;
create table Acheter (
NumFour int foreign key  references Fournissuers(NumFour),
NumArt int foreign key references Article(NumArt),
PrixAechte int ,
DateAechet datetime,
constraint pk_fe primary key(NumFour,NumArt),
);
